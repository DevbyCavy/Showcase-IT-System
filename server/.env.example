DATABASE_URL="postgresql://postgres:postgres@localhost:5432/showcase_it?schema=public"

PORT=4000
NODE_ENV=development

JWT_ACCESS_SECRET="change-me-access-secret"
JWT_REFRESH_SECRET="change-me-refresh-secret"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

CLIENT_ORIGIN="http://localhost:5173"

UPLOADS_DIR="uploads"

# "twilio" for local/dev (no template approval needed via the sandbox), "meta" once deployed.
WHATSAPP_PROVIDER="twilio"

WHATSAPP_ACCESS_TOKEN="change-me"
WHATSAPP_PHONE_NUMBER_ID="change-me"
WHATSAPP_API_VERSION="v21.0"
WHATSAPP_TEMPLATE_NAME="order_assignment_v2"
# Must match the approved template's actual language exactly (check WhatsApp Manager — templates
# are commonly approved under plain "en", not "en_US").
WHATSAPP_TEMPLATE_LANGUAGE="en"

TWILIO_ACCOUNT_SID="change-me"
TWILIO_AUTH_TOKEN="change-me"
TWILIO_WHATSAPP_FROM="+14155238886"
# Leave blank to send plain text (sandbox only) — required once the account is past the sandbox.
TWILIO_CONTENT_SID=""
