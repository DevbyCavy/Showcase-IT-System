// Showcase IT — Prisma schema (PostgreSQL)
//
// Translated from stock.sql plus tables that only exist in code (see MIGRATION_PLAN.md §3):
// requisitions, vehicles, vehicle_documents, maintenance_logs, fuel_logs, vehicle_trips, boq,
// boq_items. Column-level decisions worth knowing when reading this file:
//
// - All primary keys stay as sequential Int (not UUID). This is an internal admin system where
//   every entity already has a human-facing sequential/formatted identifier (order_number,
//   req_number, boq_number, registration_number) — UUIDs would add no benefit here, so the "use
//   UUIDs where beneficial" allowance from the brief is deliberately not used anywhere.
// - `brand.brand_status` / `category.categories_status` / `product.status` were MySQL int(11)
//   columns used as a two-state soft-delete flag (1 = visible, 2 = removed — see
//   removeBrand.php/removeCategories.php/removeProduct.php). Modeled as the `RecordStatus` enum
//   for clarity; `brand_active` / `categories_active` / `product.active` are a *different*,
//   business-meaning flag ("Available" badge) and stay separate as `isActive Boolean`.
// - Columns that were MySQL varchar despite holding numbers (product.quantity/rate,
//   orders_items.quantity/rate/total, boq_items.quantity, vehicle numeric fields) are typed
//   properly here (Int/Decimal) — an intentional, explicitly-allowed improvement. Application
//   code owns parsing/validating on the way in; no legacy code depended on these being strings.
// - OrderStatus/DocumentType/etc. enum members use PascalCase (Postgres enum identifier rules)
//   with @map(...) back to the exact legacy string where it contained a space, so displayed
//   values match the old UI exactly (e.g. "On Going", "Vehicle License").

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  engineType   = "client"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

/// Normalized per MIGRATION_PLAN.md §2.2 — the 7 live, self-consistent roles, plus Marketer
/// reintroduced per MIGRATION_PLAN.md §21 (the legacy role was dropped in §2.2 for being broken,
/// not for being unwanted — it's back as a first-class role, not a restore of the broken behavior).
enum Role {
  SuperAdmin      @map("Super Admin")
  StoresAdmin     @map("Stores Admin")
  ProjectManager  @map("Project Manager")
  Accountant      @map("Accountant")
  GraphicDesigner @map("Graphic Designer")
  ProductionTeam  @map("Production Team")
  Logistics       @map("Logistics")
  Marketer        @map("Marketer")
}

/// Soft-delete flag shared by brand/category/product (legacy: 1 = Active, 2 = Deleted).
enum RecordStatus {
  Active
  Deleted
}

enum OrderStatus {
  New
  Assigned
  OnGoing   @map("On Going")
  Completed
}

enum RequisitionType {
  Food
  Transport
  Tool
  /// Not user-selectable on the manual requisition form — only ever set by BOQ's auto-filed
  /// stock-shortfall requisitions (see MIGRATION_PLAN.md §29).
  Product
  Other
}

/// Per BOQ line item — Pending means it still has an outstanding stock shortfall (a linked
/// Product requisition exists); Fulfilled means the full quantity was available, either at BOQ
/// creation or later once a restock covered the shortfall. See MIGRATION_PLAN.md §30.
enum BoqItemStatus {
  Pending
  Fulfilled
}

enum RequisitionStatus {
  Pending
  Processed
  Approved
  Rejected
}

enum FuelType {
  Petrol
  Diesel
  Hybrid
  Electric
}

enum VehicleStatus {
  Available
  OnTrip           @map("On Trip")
  UnderMaintenance @map("Under Maintenance")
  OutOfService     @map("Out of Service")
}

enum VehicleDocumentType {
  VehicleLicense     @map("Vehicle License")
  Insurance
  FitnessCertificate @map("Fitness Certificate")
  RadioLicense       @map("Radio License")
  Other
}

enum VehicleDocumentStatus {
  Valid
  ExpiringSoon @map("Expiring Soon")
  Expired
}

enum MaintenanceType {
  Service
  OilChange       @map("Oil Change")
  TyreReplacement @map("Tyre Replacement")
  BrakeRepair     @map("Brake Repair")
  EngineRepair    @map("Engine Repair")
  AccidentRepair  @map("Accident Repair")
  Other
}

enum TripStatus {
  Active
  Completed
}

enum WorkTaskStatus {
  Running
  Completed
}

enum QuotationStatus {
  Pending
  Approved
  Rejected
}

enum MemoStatus {
  Pending
  Done
}

enum OfficeTaskStatus {
  Pending
  Completed
}

enum DesignJobType {
  Artwork
  ThreeDDesign @map("3D Design")
}

enum DesignJobStatus {
  Pending
  Done
}

/// AI Takeoff / BOQ Generator — new feature, additive alongside the existing manual Boq/BoqItem
/// module (which stays tied to Order/stock deduction). See MIGRATION_PLAN.md-adjacent design doc:
/// upload a design PDF, extract/predict quantities, review, export. Naming is prefixed `Takeoff`
/// throughout specifically to avoid colliding with the existing Boq/BoqItem models below, which is
/// a different, unrelated concept (manual line items tied to an Order).
enum TakeoffDesignStatus {
  Pending
  Processing
  /// v0.2 — extraction paused with open clarifying questions (see TakeoffClarification). Treated
  /// as non-terminal for polling purposes, same bucket as Pending/Processing.
  NeedsInput
  Ready
  Failed
}

enum TakeoffClarificationStatus {
  Pending
  Answered
}

/// Drives the auto-grow-MaterialSpec behavior on answer (see takeoffDesign.service.ts) — only a
/// Material-topic answer with a novel name creates a new MaterialSpec row.
enum TakeoffClarificationTopic {
  Material
  Measurement
  Other
}

/// Informational only — doesn't gate which extraction path(s) ran (both always run; see
/// takeoffExtraction.service.ts). Cad = a usable embedded text layer was found, Rendered = none
/// found, Mixed = some found but sparse.
enum TakeoffPdfType {
  Cad
  Rendered
  Mixed
}

enum TakeoffItemCategory {
  Structure
  Cladding
  Electrical
  Furniture
  Other
}

/// Extracted = read directly from the PDF's embedded text layer (Path A, high-confidence by
/// nature). Predicted = a vision-model best guess at an unlabeled item (e.g. furniture/electrical)
/// with no source text to anchor it. Inferred = a vision-model guess at a labeled surface's
/// material when no explicit callout exists in the text layer.
enum TakeoffItemSource {
  Extracted
  Predicted
  Inferred
}

enum TakeoffItemConfidence {
  High
  Medium
  Low
}

// ---------------------------------------------------------------------------
// Core / users
// ---------------------------------------------------------------------------

model User {
  id           Int      @id @default(autoincrement())
  username     String   @unique
  name         String
  surname      String
  userType     Role
  department   String
  passwordHash String
  email        String
  whatsappNumber String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  orderAssignments      OrderAssignment[]
  requisitionsSubmitted Requisition[]     @relation("RequisitionSubmittedBy")
  requisitionsProcessed Requisition[]     @relation("RequisitionProcessedBy")
  boqsCreated           Boq[]
  vehiclesAssigned      Vehicle[]
  vehicleTrips          VehicleTrip[]
  workShifts            WorkShift[]
  workTasks             WorkTask[]
  quotationsSubmitted   Quotation[]       @relation("QuotationSubmittedBy")
  quotationsApproved    Quotation[]       @relation("QuotationApprovedBy")
  quotationsRejected    Quotation[]       @relation("QuotationRejectedBy")
  memosCreated          Memo[]
  officeTasksAssignedBy OfficeTask[]      @relation("OfficeTaskAssignedBy")
  officeTasksAssignedTo OfficeTask[]      @relation("OfficeTaskAssignedTo")
  designJobsAssignedBy  DesignJob[]       @relation("DesignJobAssignedBy")
  designJobsAssignedTo  DesignJob[]       @relation("DesignJobAssignedTo")
  trackingLocations     TrackingLocation[]
  issuedToolsCollected  IssuedTool[]
  takeoffProjects       TakeoffProject[]
  takeoffClarificationsAnswered TakeoffClarification[]

  @@map("users")
}

// ---------------------------------------------------------------------------
// Catalog: brand / category / product
// ---------------------------------------------------------------------------

model Brand {
  id       Int          @id @default(autoincrement())
  name     String
  isActive Boolean      @default(true)
  status   RecordStatus @default(Active)

  products Product[]

  @@map("brands")
}

model Category {
  id       Int          @id @default(autoincrement())
  name     String
  isActive Boolean      @default(true)
  status   RecordStatus @default(Active)

  products Product[]

  @@map("categories")
}

model Product {
  id         Int          @id @default(autoincrement())
  name       String
  code       String
  imageUrl   String
  brandId    Int
  categoryId Int
  quantity   Int          @default(0)
  rate       Decimal      @db.Decimal(12, 2)
  isActive   Boolean      @default(true)
  status     RecordStatus @default(Active)

  brand        Brand         @relation(fields: [brandId], references: [id])
  category     Category      @relation(fields: [categoryId], references: [id])
  issuedTools  IssuedTool[]
  orderItems   OrderItem[]
  boqItems     BoqItem[]
  requisitions Requisition[]

  @@map("products")
}

/// Return reminders (§33): isReturnable + dateOfReturn asked at issue time; dateOfReturn is now
/// the due date a reminder fires on, not just a display field. collectorId replaces free-text
/// collectorName as the primary field — needed to actually reach that person with an in-app
/// reminder — but collectorName stays as a snapshot (mirrors BoqItem.productName's pattern) so the
/// row still reads fine if that account is later deleted. collectorAckAt/storesAckAt are separate
/// (not one shared field) because the collector and Stores Admin each get their own independent
/// reminder — one dismissing theirs shouldn't hide it for the other.
model IssuedTool {
  id               Int       @id @default(autoincrement())
  productId        Int
  dateOfCollection DateTime  @db.Date
  collectorId      Int?
  collectorName    String
  toolName         String
  quantityIssued   Int
  jobName          String?
  isReturnable     Boolean   @default(false)
  dateOfReturn     DateTime? @db.Date
  collectorAckAt   DateTime?
  storesAckAt      DateTime?
  createdAt        DateTime  @default(now())

  product   Product @relation(fields: [productId], references: [id])
  collector User?   @relation(fields: [collectorId], references: [id])

  @@map("issued_tools")
}

// ---------------------------------------------------------------------------
// Orders / BOQ
// ---------------------------------------------------------------------------

model Order {
  id               Int         @id @default(autoincrement())
  orderNumber      String      @unique
  orderName        String
  description      String?
  startDatetime    DateTime?
  location         String
  deadlineDatetime DateTime?
  boqFile          String?
  artworkFile      String?
  status           OrderStatus @default(New)
  /// Set when status flips to OnGoing; drives the 24h auto-complete window (see MIGRATION_PLAN.md §4 Module 8).
  ongoingSince     DateTime?
  createdAt        DateTime    @default(now())

  items       OrderItem[]
  assignments OrderAssignment[]
  boqs        Boq[]

  @@map("orders")
}

model OrderItem {
  id         Int     @id @default(autoincrement())
  orderId    Int
  productId  Int
  quantity   Decimal @db.Decimal(12, 2)
  rate       Decimal @db.Decimal(12, 2)
  total      Decimal @db.Decimal(12, 2)
  /// Legacy orders_item_status column — no reachable code path reads/writes this today; kept for parity.
  itemStatus Int     @default(1)

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@map("order_items")
}

model OrderAssignment {
  id      Int @id @default(autoincrement())
  orderId Int
  userId  Int

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("order_assignments")
}

/// Scoped from feature/boq-stock-requisitions per MIGRATION_PLAN.md §2.1.
model Boq {
  id          Int      @id @default(autoincrement())
  boqNumber   String   @unique
  orderId     Int
  orderNumber String
  eventName   String
  clientName  String?
  location    String
  createdById Int
  createdAt   DateTime @default(now())

  order     Order     @relation(fields: [orderId], references: [id])
  createdBy User      @relation(fields: [createdById], references: [id])
  items     BoqItem[]

  @@map("boqs")
}

model BoqItem {
  id          Int     @id @default(autoincrement())
  boqId       Int
  /// Now catalog-linked (was free-text) so filling a BOQ can deduct real Store stock — see
  /// MIGRATION_PLAN.md §29. Nullable at the DB level only because pre-existing rows predate this
  /// field and were never tied to a product; the create path (boq.validation.ts) requires it for
  /// every new item. productName is a snapshot of the product's name at BOQ creation time
  /// (survives a later rename), not re-derived from the live product on read.
  productId   Int?
  productName String
  description String?
  unit        String?
  quantity    Decimal       @db.Decimal(12, 2)
  /// See MIGRATION_PLAN.md §30 — flips to Fulfilled once a restock covers the linked shortfall
  /// requisition (see Requisition.boqItemId below). Defaults to Fulfilled so the 3 pre-existing
  /// rows that predate this field (never stock-linked, nothing outstanding) don't show as Pending.
  status      BoqItemStatus @default(Fulfilled)

  boq          Boq           @relation(fields: [boqId], references: [id], onDelete: Cascade)
  product      Product?      @relation(fields: [productId], references: [id])
  requisitions Requisition[]

  @@map("boq_items")
}

// ---------------------------------------------------------------------------
// Requisitions
// ---------------------------------------------------------------------------

model Requisition {
  id             Int               @id @default(autoincrement())
  reqNumber      String            @unique
  projectManager String
  eventName      String
  location       String
  eventDate      DateTime          @db.Date
  teamMembers    String?
  reqType        RequisitionType
  /// Custom label when reqType == Other (see createRequisition.php — also duplicated into reqType itself).
  reqTypeOther   String?
  /// Set only when reqType == Product — the out-of-stock item a BOQ couldn't fully deduct, and
  /// how much is still needed. See MIGRATION_PLAN.md §29.
  productId      Int?
  quantity       Decimal?          @db.Decimal(12, 2)
  /// Traces a Product-type requisition back to the exact BOQ line it was filed for, so restocking
  /// (product.repository.ts#fulfillShortfallsInTx) knows which BoqItem to flip to Fulfilled once
  /// this requisition's shortfall is covered. See MIGRATION_PLAN.md §30.
  boqItemId      Int?
  submittedById  Int
  status         RequisitionStatus @default(Pending)
  processedById  Int?
  processedAt    DateTime?
  createdAt      DateTime          @default(now())

  submittedBy User     @relation("RequisitionSubmittedBy", fields: [submittedById], references: [id])
  processedBy User?    @relation("RequisitionProcessedBy", fields: [processedById], references: [id])
  product     Product? @relation(fields: [productId], references: [id])
  boqItem     BoqItem? @relation(fields: [boqItemId], references: [id])

  @@map("requisitions")
}

// ---------------------------------------------------------------------------
// Logistics / vehicles
// ---------------------------------------------------------------------------

model Vehicle {
  id                 Int           @id @default(autoincrement())
  registrationNumber String        @unique
  make               String
  model              String
  vehicleYear        Int
  color              String
  fuelType           FuelType
  capacity           String
  department         String
  assignedUserId     Int?
  status             VehicleStatus @default(Available)
  purchaseDate       DateTime      @db.Date
  notes              String?

  assignedUser      User?              @relation(fields: [assignedUserId], references: [id])
  documents         VehicleDocument[]
  maintenance       MaintenanceLog[]
  fuelLogs          FuelLog[]
  trips             VehicleTrip[]
  trackingLocations TrackingLocation[]

  @@map("vehicles")
}

model VehicleDocument {
  id             Int                   @id @default(autoincrement())
  vehicleId      Int
  documentType   VehicleDocumentType
  documentNumber String
  issueDate      DateTime              @db.Date
  expiryDate     DateTime              @db.Date
  reminderDays   Int
  status         VehicleDocumentStatus
  uploadedFile   String?
  notes          String?

  vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@map("vehicle_documents")
}

model MaintenanceLog {
  id                  Int             @id @default(autoincrement())
  vehicleId           Int
  maintenanceType     MaintenanceType
  serviceProvider     String?
  serviceDate         DateTime        @db.Date
  odometerReading     Decimal?        @db.Decimal(12, 2)
  serviceCost         Decimal?        @db.Decimal(12, 2)
  nextServiceDate     DateTime?       @db.Date
  nextServiceOdometer Decimal?        @db.Decimal(12, 2)
  notes               String?

  vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@map("maintenance_logs")
}

model FuelLog {
  id              Int      @id @default(autoincrement())
  vehicleId       Int
  fuelDate        DateTime @db.Date
  odometerReading Decimal  @db.Decimal(12, 2)
  litres          Decimal  @db.Decimal(10, 2)
  fuelCost        Decimal  @db.Decimal(12, 2)
  fuelStation     String?
  receiptNumber   String?
  notes           String?

  vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@map("fuel_logs")
}

model VehicleTrip {
  id                Int        @id @default(autoincrement())
  vehicleId         Int
  userId            Int
  destination       String
  purpose           String?
  departureDatetime DateTime
  returnDatetime    DateTime?
  odometerStart     Decimal    @db.Decimal(12, 2)
  odometerEnd       Decimal?   @db.Decimal(12, 2)
  distanceTravelled Decimal?   @db.Decimal(12, 2)
  remarks           String?
  tripStatus        TripStatus @default(Active)

  vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id])

  trackingLocations TrackingLocation[]

  @@map("vehicle_trips")
}

/// New feature: live GPS tracking of drivers during a trip via the browser's Geolocation API
/// (navigator.geolocation) — no external GPS hardware. Each row is one location ping. See
/// MIGRATION_PLAN.md §24.
model TrackingLocation {
  id        Int      @id @default(autoincrement())
  tripId    Int
  vehicleId Int
  userId    Int
  latitude  Decimal  @db.Decimal(10, 7)
  longitude Decimal  @db.Decimal(10, 7)
  accuracy  Decimal? @db.Decimal(10, 2)
  speed     Decimal? @db.Decimal(10, 2)
  heading   Decimal? @db.Decimal(6, 2)
  timestamp DateTime @default(now())

  trip    VehicleTrip @relation(fields: [tripId], references: [id], onDelete: Cascade)
  vehicle Vehicle     @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  user    User        @relation(fields: [userId], references: [id])

  @@index([tripId])
  @@index([vehicleId])
  @@index([timestamp])
  @@map("tracking_locations")
}

// ---------------------------------------------------------------------------
// Work Log Sheet — new feature, scoped from feature/work-log-sheet (never merged to main,
// see MIGRATION_PLAN.md §10). One shift row per user per day; a shift has many tasks.
// ---------------------------------------------------------------------------

model WorkShift {
  id           Int       @id @default(autoincrement())
  userId       Int
  shiftDate    DateTime  @db.Date
  loginTime    DateTime
  eveningShift Boolean   @default(false)
  /// Legacy logout_time column — no endpoint on the source branch ever wrote to it either; kept
  /// for schema parity, not exposed by any endpoint here.
  logoutTime   DateTime?

  user  User       @relation(fields: [userId], references: [id])
  tasks WorkTask[]

  @@unique([userId, shiftDate])
  @@map("work_shifts")
}

model WorkTask {
  id        Int            @id @default(autoincrement())
  shiftId   Int
  userId    Int
  taskName  String
  taskNotes String?
  startTime DateTime
  endTime   DateTime?
  status    WorkTaskStatus @default(Running)
  createdAt DateTime       @default(now())

  shift WorkShift @relation(fields: [shiftId], references: [id], onDelete: Cascade)
  user  User      @relation(fields: [userId], references: [id])

  @@map("work_tasks")
}

// ---------------------------------------------------------------------------
// Quotations — new feature, scoped from feature/work-log-sheet (see MIGRATION_PLAN.md §10).
// Legacy gated *submission* to a "Marketer" role already dropped during Module 2's role
// normalization (a broken/unreachable role string) — open to any authenticated user here instead.
// ---------------------------------------------------------------------------

model Quotation {
  id              Int             @id @default(autoincrement())
  quotationNumber String          @unique
  customerName    String
  customerId      String?
  projectName     String?
  orderNumber     String?
  quoteDate       DateTime        @db.Date
  termsConditions String
  designFile      String?
  subtotal        Decimal         @db.Decimal(12, 2)
  /// Optional 15.5% VAT, on top of subtotal. Stored (not just derived from a flag) so a
  /// quotation's PDF stays accurate even if the VAT rate itself changes later — total is always
  /// subtotal + vatAmount, vatAmount is 0 when applyVat is false.
  applyVat        Boolean         @default(false)
  vatAmount       Decimal         @db.Decimal(12, 2) @default(0)
  total           Decimal         @db.Decimal(12, 2)
  status          QuotationStatus @default(Pending)
  submittedById   Int
  approvedById    Int?
  approvedAt      DateTime?
  rejectedById    Int?
  rejectedAt      DateTime?
  rejectionReason String?
  createdAt       DateTime        @default(now())

  submittedBy User            @relation("QuotationSubmittedBy", fields: [submittedById], references: [id])
  approvedBy  User?           @relation("QuotationApprovedBy", fields: [approvedById], references: [id])
  rejectedBy  User?           @relation("QuotationRejectedBy", fields: [rejectedById], references: [id])
  items       QuotationItem[]

  @@map("quotations")
}

model QuotationItem {
  id          Int     @id @default(autoincrement())
  quotationId Int
  description String
  quantity    Decimal @db.Decimal(12, 2)
  unitPrice   Decimal @db.Decimal(12, 2)
  lineTotal   Decimal @db.Decimal(12, 2)
  sortOrder   Int     @default(0)

  quotation Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)

  @@map("quotation_items")
}

// ---------------------------------------------------------------------------
// Office Task Calendar — new feature, scoped from feature/office-task-calendar (never merged to
// main, see MIGRATION_PLAN.md §10). Memo is a lightweight personal to-do (feeds the calendar's
// "To-Do" quick-add); OfficeTask is the actual "office task management" entity — assign a job to
// any user regardless of department. The Marketer Memos feature this table also belongs to
// (due-date reminder popup, dedicated memo page) lives on a separate, unrequested branch and is
// out of scope here.
// ---------------------------------------------------------------------------

model Memo {
  id             Int        @id @default(autoincrement())
  title          String
  description    String?
  dueDate        DateTime
  status         MemoStatus @default(Pending)
  acknowledgedAt DateTime?
  createdById    Int?
  createdAt      DateTime   @default(now())

  createdBy User? @relation(fields: [createdById], references: [id])

  @@map("memos")
}

model OfficeTask {
  id           Int              @id @default(autoincrement())
  title        String
  description  String?
  dueDate      DateTime         @db.Date
  status       OfficeTaskStatus @default(Pending)
  assignedById Int?
  assignedToId Int?
  createdAt    DateTime         @default(now())

  assignedBy User? @relation("OfficeTaskAssignedBy", fields: [assignedById], references: [id])
  assignedTo User? @relation("OfficeTaskAssignedTo", fields: [assignedToId], references: [id])

  @@map("office_tasks")
}

/// New feature: Marketer/Super Admin assign a design job (Artwork or 3D Design) to a Graphic
/// Designer, with an optional sample reference file and a required deadline — see
/// MIGRATION_PLAN.md §22. Standalone, not tied to an Order (Calvin's explicit choice).
model DesignJob {
  id            Int             @id @default(autoincrement())
  title         String
  jobType       DesignJobType
  description   String?
  sampleFile    String?
  deadline      DateTime
  status        DesignJobStatus @default(Pending)
  completedFile String?
  completedAt   DateTime?
  assignedById  Int
  assignedToId  Int
  createdAt     DateTime        @default(now())

  assignedBy User @relation("DesignJobAssignedBy", fields: [assignedById], references: [id])
  assignedTo User @relation("DesignJobAssignedTo", fields: [assignedToId], references: [id])

  @@map("design_jobs")
}

// ---------------------------------------------------------------------------
// AI Takeoff / BOQ Generator — new feature, additive alongside Orders/BOQ above. A user's
// standalone Project holds design PDF uploads (Design); each upload runs an async
// extraction/prediction pipeline producing reviewable, editable Item rows. Single-owner projects,
// one active pipeline run per uploaded Design — no team sharing or design revisioning in v0.1.
// ---------------------------------------------------------------------------

model TakeoffProject {
  id         Int      @id @default(autoincrement())
  userId     Int
  name       String
  clientName String?
  createdAt  DateTime @default(now())

  user    User            @relation(fields: [userId], references: [id])
  designs TakeoffDesign[]

  @@map("takeoff_projects")
}

model TakeoffDesign {
  id               Int                 @id @default(autoincrement())
  projectId        Int
  originalFilename String
  storagePath      String
  pdfType          TakeoffPdfType?
  status           TakeoffDesignStatus @default(Pending)
  /// Set when status flips to Failed — the error message from the extraction pipeline.
  failureReason    String?
  uploadedAt       DateTime            @default(now())

  project TakeoffProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  items   TakeoffItem[]
  clarifications TakeoffClarification[]

  @@map("takeoff_designs")
}

/// v0.2 — a gap the extraction pipeline couldn't confidently fill on its own (see
/// takeoffExtraction.service.ts's runExtraction/runFinalization). Answered rows double as the
/// system's cross-design memory: every prompt queries the global set of Answered clarifications
/// (not scoped to one design/project) so the same question isn't asked twice across designs.
model TakeoffClarification {
  id           Int                        @id @default(autoincrement())
  designId     Int
  topic        TakeoffClarificationTopic
  question     String
  status       TakeoffClarificationStatus @default(Pending)
  answer       String?
  answeredById Int?
  answeredAt   DateTime?
  createdAt    DateTime                   @default(now())

  design     TakeoffDesign @relation(fields: [designId], references: [id], onDelete: Cascade)
  answeredBy User?         @relation(fields: [answeredById], references: [id])

  @@map("takeoff_clarifications")
}

model TakeoffItem {
  id          Int                   @id @default(autoincrement())
  designId    Int
  description String
  category    TakeoffItemCategory
  material    String?
  widthMm     Decimal?              @db.Decimal(10, 2)
  heightMm    Decimal?              @db.Decimal(10, 2)
  lengthMm    Decimal?              @db.Decimal(10, 2)
  unit        String
  quantity    Decimal               @db.Decimal(12, 2)
  source      TakeoffItemSource
  confidence  TakeoffItemConfidence
  notes       String?

  design TakeoffDesign @relation(fields: [designId], references: [id], onDelete: Cascade)

  @@map("takeoff_items")
}

/// Reference table of known build materials (sheet sizes, thicknesses, waste factor) used by Path
/// A's material-name matching and shown for editing on the /materials admin screen. unitCost stays
/// nullable/unused in v0.1 — reserved for a future priced-BOQ phase, not populated by anything yet.
model MaterialSpec {
  id                 Int      @id @default(autoincrement())
  name               String   @unique
  unit               String
  standardSheetWmm   Decimal? @db.Decimal(10, 2)
  standardSheetHmm   Decimal? @db.Decimal(10, 2)
  typicalThicknessMm Float[]
  standardLengthsMm  Float[]
  wasteFactor        Decimal  @default(1.10) @db.Decimal(4, 2)
  unitCost           Decimal? @db.Decimal(12, 2)

  @@map("material_specs")
}
